# Copy to .env and adjust. Never put real secrets here (AGENTS.md rule 5).

# Required: no default, backend refuses to start without it.
DJANGO_SECRET_KEY=change-me-dev-only

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local Postgres from `docker compose up -d db` (exposed on port 5433).
POSTGRES_DB=ohh
POSTGRES_USER=ohh
POSTGRES_PASSWORD=ohh-dev-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
